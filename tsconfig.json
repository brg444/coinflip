{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": ["app/src/**/*.ts", "contracts/**/*.ts", "protocol/**/*.ts", "desk/**/*.ts", "settle/**/*.ts", "scripts/**/*.ts"]
}
