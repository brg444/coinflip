  "source": {
    "entry": "predict_vault.ark",
    "files": {
      "predict_vault.ark": "pragma arkade ^0.1.0;\n\n// All-or-nothing vault (kind 2 higher, kind 3 lower); exact strike pays the writer.\n// Settles standalone (1 input) by verifying the pinned DIA EIP-712 price signature and\n// the oracle's canonical fixing signature directly on the stack — no shared beacon coin.\ncontract PredictVault(\n  int kind,\n  pubkey writerPk,\n  pubkey holderPk,\n  ScriptPubKey writerScript,\n  ScriptPubKey holderScript,\n  int strike,\n  int collateral,\n  int stake,\n  int expiry,\n  pubkey oraclePk,\n  pubkey backupPk,\n  int voidAfter,\n  int fallbackDelay,\n  int finalExitDelay\n) {\n  const int DUST = 330;\n  const int PRICE_MAX = 1000000000;\n  const int Q_MAX = 1000000000;\n  const int EXPIRY_LAG = 60;\n  const int GRID = 300;\n  const int SCALE = 10000000000000000;\n  const int HALF = 5000000000000000;\n\n  private function word(int n) bytes {\n    return reverseBytes(int2bytes(n, 32));\n  }\n\n  @allow(unsigned-spend-path, \"authorized by pinned DIA EIP-712 signature and oraclePk canonical fixing signature\")\n  function settle(int price, int time, int nonce, int intentExpiry, signature sig, signature oracleSig) {\n    require(kind == 2 || kind == 3, \"kind\");\n    require(strike > 0, \"strike\");\n    require(strike <= PRICE_MAX, \"strike cap\");\n    require(collateral > DUST, \"collateral\");\n    require(collateral <= Q_MAX, \"collateral cap\");\n    require(expiry > 1800, \"expiry\");\n    require(expiry % GRID == 0, \"expiry grid\");\n    require(checkTime(expiry + EXPIRY_LAG), \"before expiry close\");\n    require(this.activeInputIndex == 0, \"vault is input 0\");\n    require(tx.numInputs == 1, \"vault only\");\n\n    require(price > 0, \"nonpositive price\");\n    require(time >= expiry, \"sample before expiry\");\n    require(time <= expiry + EXPIRY_LAG, \"sample after close\");\n\n    int q = price / SCALE;\n    int r = price % SCALE;\n    int st = q;\n    if (r >= HALF) {\n      st = q + 1;\n    }\n    require(st > 0, \"price\");\n    require(st <= PRICE_MAX, \"price cap\");\n\n    bytes body = 0x24e574fa7512cc24e9109b981256e33759d91bc2ee9b74a2bf633e013c0620b5\n      + 0xef9b6324ed493183babb66ed98fcf36e9bcb0243ae4c5a29fcd99184b08f1899\n      + 0xe6bbd6277e1bf288eed5e8d1780f9a50b239e86b153736bceebccf4ea79d90b3\n      + word(1050)\n      + word(nonce)\n      + word(intentExpiry)\n      + 0xee62665949c883f9e0f6f002eac32e00bd59dfe6c34e92a91c37d6a8322d6489\n      + word(price)\n      + word(time)\n      + 0xf5a695b63ab16fd8278cb1cf7d29f274a9574b64e0b894750e08c990fc8891bc;\n    bytes32 message = bytes32(digest(\n      0x1901\n        + 0xf57d55f057fd4aba6b1a7f8bccb6a3e826cf71fd34971f22a39d7ffd6e620fb3\n        + bytes32(digest(body, 4)),\n      4\n    ));\n    require(checkSigFromStack(sig, 0x100211ee120bca9f272034d98b1b026bb4ab735ebeb5da8be6a69bf7ee0ea24cfd48, message), \"dia\");\n\n    let fixMsg = sha256(\n      bytes(\"BTCUSD-FIX\") + bytes(\"fix\") + int2bytes(expiry, 8) + int2bytes(st, 8) + int2bytes(time, 8)\n    );\n    require(checkSigFromStack(oracleSig, oraclePk, fixMsg), \"oracle\");\n\n    int ph = 0;\n    if (kind == 2) {\n      if (st > strike) {\n        ph = collateral;\n      }\n    }\n    if (kind == 3) {\n      if (st < strike) {\n        ph = collateral;\n      }\n    }\n\n    int locked = tx.input.current.value;\n    require(locked >= collateral, \"underfunded\");\n    int phPay = ph;\n    if (phPay > locked) {\n      phPay = locked;\n    }\n    int writerAmt = locked - phPay;\n\n    let out0 = tx.outputs[0].script;\n    if (phPay > DUST && writerAmt > DUST) {\n      require(tx.outputs[0].value >= phPay, \"holder short\");\n      require(out0 == holderScript, \"holder script\");\n      require(tx.outputs[1].value >= writerAmt, \"writer short\");\n      require(tx.outputs[1].script == writerScript, \"writer script\");\n    }\n    if (phPay <= DUST) {\n      require(tx.outputs[0].value >= locked, \"writer short\");\n      require(out0 == writerScript, \"writer script\");\n    }\n    if (writerAmt <= DUST && phPay > DUST) {\n      require(tx.outputs[0].value >= locked, \"holder short\");\n      require(out0 == holderScript, \"holder script\");\n    }\n  }\n\n  @allow(unsigned-spend-path, \"permissionless void after expiry + voidAfter returns stake to holder and rest to writer\")\n  function refund() {\n    require(voidAfter > 0, \"voidAfter\");\n    require(checkTime(expiry + voidAfter), \"too early to void\");\n    require(this.activeInputIndex == 0, \"vault is input 0\");\n    require(stake > DUST, \"stake\");\n    require(stake <= Q_MAX, \"stake cap\");\n    int locked = tx.input.current.value;\n    require(locked >= stake, \"underfunded\");\n    int house = locked - stake;\n    require(tx.outputs[0].script == holderScript, \"holder script\");\n    if (house > DUST) {\n      require(tx.outputs[0].value >= stake, \"stake back\");\n      require(tx.outputs[1].script == writerScript, \"writer script\");\n      require(tx.outputs[1].value >= house, \"house share\");\n    }\n    if (house <= DUST) {\n      require(tx.outputs[0].value >= locked, \"stake back\");\n    }\n  }\n\n  @allow(unsigned-spend-path, \"permissionless batch reboard/renewal preserving vault script and value\")\n  function reboard() {\n    require(tx.version == 2, \"intent only\");\n    bytes intentType = tx.intent.field(bytes(\"type\"));\n    require(intentType == bytes(\"register\") || intentType == bytes(\"delete\"), \"intent type\");\n    if (intentType == bytes(\"register\")) {\n      require(tx.intent.field(bytes(\"onchain_output_indexes\")) == bytes(\"[]\"), \"onchain output\");\n    }\n    require(this.activeInputIndex >= 1, \"intent input\");\n    require(this.tunnel(this.activeInputIndex - 1), \"same position\");\n  }\n\n  function close(signature writerSig, signature holderSig) {\n    require(checkSig(writerSig, writerPk), \"writer\");\n    require(checkSig(holderSig, holderPk), \"holder\");\n  }\n\n  function refundBackup(signature backupSig) tapscript {\n    require(older(fallbackDelay));\n    require(checkSig(backupSig, tweak(backupPk, refund)));\n  }\n\n  function unilateral(signature writerSig, signature holderSig) tapscript {\n    require(older(finalExitDelay));\n    require(checkMultisig([writerPk, holderPk], [writerSig, holderSig]));\n  }\n}\n"
    }
  },
  "compiler": {
    "name": "arkadec",
    "version": "0.1.0",
    "options": {
      "optimize": true
    }
  },
