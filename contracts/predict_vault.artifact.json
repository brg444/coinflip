  "source": {
    "entry": "predict_vault.ark",
    "files": {
      "predict_vault.ark": "pragma arkade ^0.1.0;\n\n// All-or-nothing call on where BTC closes: higher (kind 2) or lower (kind 3)\n// than a line. The settlement price comes from the same AttestationBeacon\n// OptionVault reads, spent in the same transaction.\n//\n// The desk is the writer and funds `collateral`, the payout. The holder paid\n// the stake to the desk when the intent filled. Settle spends this coin as\n// input 0 and the beacon as input 1. Output 0 is the beacon's continuation,\n// with readFee sats of this coin added to it. Payouts start at output 1 and\n// sum to the locked value minus readFee.\n//\n// The settlement price is the newest fixing whose key equals `expiry` in the\n// beacon state packet, the first 8 bytes of that slot's value, in USD cents.\n//   higher: ST >  K -> holder gets the collateral, else 0\n//   lower:  ST <  K -> holder gets the collateral, else 0\n// A close exactly on the line pays the writer for both kinds.\n// A leg of DUST sats or less is folded into the other output.\n//\n// Spend paths: settle (anyone, once the emulator clock reaches expiry), close\n// (writer and holder together), unilateral (writer, after CSV). Same as\n// OptionVault; only the payoff differs.\n\ncontract PredictVault(\n  int kind,\n  pubkey writerPk,\n  pubkey holderPk,\n  bytes32 writerScript,\n  bytes32 holderScript,\n  int strike,\n  int collateral,\n  int expiry,\n  bytes32 beaconTxid,\n  int beaconGidx,\n  int readFee,\n  int exit\n) {\n  const int DUST = 330;\n  const int PRICE_MAX = 1000000000;\n  const int Q_MAX = 1000000000;\n  const int STATE = 32;\n  const int SIZE = 329;\n\n  function settle() {\n    require(kind == 2 || kind == 3, \"kind\");\n    require(strike > 0, \"strike\");\n    require(strike <= PRICE_MAX, \"strike cap\");\n    require(collateral > DUST, \"collateral\");\n    require(collateral <= Q_MAX, \"collateral cap\");\n    require(checkTime(expiry), \"before expiry\");\n    require(this.activeInputIndex == 0, \"vault is input 0\");\n    require(tx.numInputs >= 2, \"vault and beacon\");\n    require(tx.inputs[1].assets.lookup(beaconTxid, beaconGidx) == 1, \"beacon\");\n\n    bytes state = tx.inputs[1].packet(STATE);\n    require(size(state) == SIZE, \"state size\");\n    require(substr(state, 0, 1) == 0x01, \"state version\");\n\n    int st = 0;\n    int found = 0;\n    int[8] slots = [9, 49, 89, 129, 169, 209, 249, 289];\n    for (i, offset) in slots {\n      if (found == 0 && substr(state, offset, 8) == num2bin(expiry, 8)) {\n        st = bin2num(substr(state, (offset + 8), 8));\n        found = 1;\n      }\n    }\n    require(found == 1, \"no fixing for expiry\");\n    require(st > 0, \"price\");\n    require(st <= PRICE_MAX, \"price cap\");\n\n    int ph = 0;\n    if (kind == 2) {\n      if (st > strike) {\n        ph = collateral;\n      }\n    }\n    if (kind == 3) {\n      if (st < strike) {\n        ph = collateral;\n      }\n    }\n\n    int locked = tx.input.current.value;\n    require(locked >= collateral, \"underfunded\");\n    require(readFee >= 0, \"fee\");\n    require(locked >= readFee, \"fee\");\n    int pot = locked - readFee;\n    int phPay = ph;\n    if (phPay > pot) {\n      phPay = pot;\n    }\n    int writerAmt = pot - phPay;\n\n    if (phPay > DUST && writerAmt > DUST) {\n      require(tx.outputs[1].value >= phPay, \"holder short\");\n      require(tx.outputs[1].scriptPubKey == holderScript, \"holder script\");\n      require(tx.outputs[2].value >= writerAmt, \"writer short\");\n      require(tx.outputs[2].scriptPubKey == writerScript, \"writer script\");\n    }\n    if (phPay <= DUST) {\n      require(tx.outputs[1].value >= pot, \"writer short\");\n      require(tx.outputs[1].scriptPubKey == writerScript, \"writer script\");\n    }\n    if (writerAmt <= DUST && phPay > DUST) {\n      require(tx.outputs[1].value >= pot, \"holder short\");\n      require(tx.outputs[1].scriptPubKey == holderScript, \"holder script\");\n    }\n  }\n\n  function close(signature writerSig, signature holderSig) {\n    require(checkSig(writerSig, writerPk), \"writer\");\n    require(checkSig(holderSig, holderPk), \"holder\");\n  }\n\n  function unilateral(signature writerSig) tapscript {\n    require(older(exit));\n    require(checkSig(writerSig, writerPk));\n  }\n}\n"
    }
  },
