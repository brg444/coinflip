pragma arkade ^0.1.0;

import "./dia_btc_usd_cents.ark";

// All-or-nothing direct-DIA vault (kind 2 higher, kind 3 lower); exact strike pays the writer.
contract PredictVault(
  int kind,
  pubkey writerPk,
  pubkey holderPk,
  ScriptPubKey writerScript,
  ScriptPubKey holderScript,
  int strike,
  int collateral,
  int stake,
  int expiry,
  bytes oraclePk,
  pubkey backupPk,
  int voidAfter,
  int fallbackDelay,
  int finalExitDelay
) {
  const int DUST = 330;
  const int PRICE_MAX = 1000000000;
  const int Q_MAX = 1000000000;
  const int EXPIRY_LAG = 60;

  @allow(unsigned-spend-path, "authorized by pinned DIA EIP-712 signature within the close window")
  function settle(int rawPrice, int time, int nonce, int intentExpiry, signature oracleSig) {
    require(kind == 2 || kind == 3, "kind");
    require(strike > 0, "strike");
    require(strike <= PRICE_MAX, "strike cap");
    require(collateral > DUST, "collateral");
    require(collateral <= Q_MAX, "collateral cap");
    require(checkTime(expiry), "before expiry");
    require(this.activeInputIndex == 0, "vault is input 0");
    require(time >= expiry, "sample before expiry");
    require(time <= expiry + EXPIRY_LAG, "sample after close");

    int st = DiaBtcUsdCents.verifyPrice(oraclePk, rawPrice, time, nonce, intentExpiry, oracleSig);

    int holderWins = 0;
    if (kind == 2 && st > strike) {
      holderWins = 1;
    }
    if (kind == 3 && st < strike) {
      holderWins = 1;
    }

    int locked = tx.input.current.value;
    require(locked >= collateral, "underfunded");
    let out0 = tx.outputs[0].script;
    require(tx.outputs[0].value >= locked, "payout short");
    if (holderWins == 1) {
      require(out0 == holderScript, "holder script");
    }
    if (holderWins == 0) {
      require(out0 == writerScript, "writer script");
    }
  }

  @allow(unsigned-spend-path, "permissionless void after expiry + voidAfter returns stake to holder and rest to writer")
  function refund() {
    require(voidAfter > 0, "voidAfter");
    require(checkTime(expiry + voidAfter), "too early to void");
    require(this.activeInputIndex == 0, "vault is input 0");
    require(stake > DUST, "stake");
    require(stake <= Q_MAX, "stake cap");
    int locked = tx.input.current.value;
    require(locked >= stake, "underfunded");
    int house = locked - stake;
    require(tx.outputs[0].script == holderScript, "holder script");
    if (house > DUST) {
      require(tx.outputs[0].value >= stake, "stake back");
      require(tx.outputs[1].script == writerScript, "writer script");
      require(tx.outputs[1].value >= house, "house share");
    }
    if (house <= DUST) {
      require(tx.outputs[0].value >= locked, "stake back");
    }
  }

  @allow(unsigned-spend-path, "permissionless batch reboard/renewal preserving vault script and value")
  function reboard() {
    require(tx.version == 2, "intent only");
    bytes intentType = tx.intent.field(bytes("type"));
    require(intentType == bytes("register") || intentType == bytes("delete"), "intent type");
    if (intentType == bytes("register")) {
      require(tx.intent.field(bytes("onchain_output_indexes")) == bytes("[]"), "onchain output");
    }
    require(this.activeInputIndex >= 1, "intent input");
    require(this.tunnel(this.activeInputIndex - 1), "same position");
  }

  function close(signature writerSig, signature holderSig) {
    require(checkSig(writerSig, writerPk), "writer");
    require(checkSig(holderSig, holderPk), "holder");
  }

  function settleBackup(signature backupSig) tapscript {
    require(older(fallbackDelay));
    require(checkSig(backupSig, tweak(backupPk, settle)));
  }

  function refundBackup(signature backupSig) tapscript {
    require(older(fallbackDelay));
    require(checkSig(backupSig, tweak(backupPk, refund)));
  }

  function unilateral(signature writerSig, signature holderSig) tapscript {
    require(older(finalExitDelay));
    require(checkMultisig([writerPk, holderPk], [writerSig, holderSig]));
  }
}
