pragma arkade ^0.1.0;

// AttestationBeacon: a price registry that other covenants read by spending
// it in the same transaction.
//
// A fixing is one DIA OracleUpdate for BTC/USD, co-authorized by the oracle
// service's adminPk so only the canonical fixing for each 5-minute close can be
// recorded while DIA's EIP-712 signature prevents the oracle from inventing prices.
// Close times must sit on the 5-minute grid and strictly advance so old closes
// cannot be flushed and overwritten.
//
// State is the extension packet of type STATE, 329 bytes:
//   0        version, 0x01
//   1..9     round, int2bytes(round, 8)
//   9..329   8 slots of 40 bytes, newest first: expiry int2bytes(expiry, 8), value 32 bytes
// The value keeps the cents in the first 8 bytes. The next 8 are the sample
// time. The rest are zero.

contract AttestationBeacon(
  bytes32 ctrlTxid,
  int ctrlGidx,
  bytes domain,
  int expiryLag,
  int readFee,
  pubkey adminPk,
  int exit
) {
  const int STATE = 32;
  const int SIZE = 329;
  const int SLOTS = 9;
  const int VALUE_AT = 17;
  const int HISTORY_AT = 49;
  const int HISTORY = 280;
  const int GRID = 300;
  const int PRICE_MAX = 1000000000;
  const int SCALE = 10000000000000000;
  const int HALF = 5000000000000000;

  private function continues(bytes state) {
    require(size(state) == SIZE, "state size");
    require(substr(state, 0, 1) == 0x01, "state version");
    require(tx.outputs[0].script == tx.input.current.script, "script");
    require(tx.outputs[0].assets.lookup(AssetId { txid: ctrlTxid, gidx: ctrlGidx }) == 1, "identity asset");
  }

  private function absent(bytes prev, int expiry) {
    int[8] slots = [9, 49, 89, 129, 169, 209, 249, 289];
    for (i, offset) in slots {
      require(substr(prev, offset, 8) != int2bytes(expiry, 8), "expiry already in a slot");
    }
  }

  private function word(int n) bytes {
    return reverseBytes(int2bytes(n, 32));
  }

  @allow(unsigned-spend-path, "authorized by both pinned DIA EIP-712 signature and oracle adminPk")
  function attest(int expiry, int price, int time, int nonce, int intentExpiry, signature sig, signature adminSig) {
    require(this.activeInputIndex == 0, "beacon is input 0");
    require(expiry > 1800, "expiry");
    require(expiry % GRID == 0, "expiry grid");
    if (expiryLag >= 0) {
      require(checkTime(expiry + expiryLag), "before expiry time");
    }
    require(price > 0, "nonpositive price");
    require(time >= expiry, "sample before expiry");
    require(time <= expiry + expiryLag, "sample after close");

    int q = price / SCALE;
    int r = price % SCALE;
    int cents = q;
    if (r >= HALF) {
      cents = q + 1;
    }
    require(cents > 0, "price");
    require(cents <= PRICE_MAX, "price cap");

    bytes body = 0x24e574fa7512cc24e9109b981256e33759d91bc2ee9b74a2bf633e013c0620b5
      + 0xef9b6324ed493183babb66ed98fcf36e9bcb0243ae4c5a29fcd99184b08f1899
      + 0xe6bbd6277e1bf288eed5e8d1780f9a50b239e86b153736bceebccf4ea79d90b3
      + word(1050)
      + word(nonce)
      + word(intentExpiry)
      + 0xee62665949c883f9e0f6f002eac32e00bd59dfe6c34e92a91c37d6a8322d6489
      + word(price)
      + word(time)
      + 0xf5a695b63ab16fd8278cb1cf7d29f274a9574b64e0b894750e08c990fc8891bc;
    bytes32 message = bytes32(digest(
      0x1901
        + 0xf57d55f057fd4aba6b1a7f8bccb6a3e826cf71fd34971f22a39d7ffd6e620fb3
        + bytes32(digest(body, 4)),
      4
    ));
    require(checkSigFromStack(sig, 0x100211ee120bca9f272034d98b1b026bb4ab735ebeb5da8be6a69bf7ee0ea24cfd48, message), "dia");

    bytes prev = tx.inputs[0].packet(STATE);
    bytes next = tx.packet(STATE);
    require(size(prev) == SIZE, "prev size");
    require(size(next) == SIZE, "next size");
    require(substr(prev, 0, 1) == 0x01, "prev version");
    require(substr(next, 0, 1) == 0x01, "next version");
    int lastExpiry = bytes2int(substr(prev, SLOTS, 8));
    require(expiry > lastExpiry, "expiry order");
    absent(prev, expiry);
    int round = bytes2int(substr(prev, 1, 8));
    let attestMsg = sha256(
      domain + "attest" + ctrlTxid + int2bytes(ctrlGidx, 4) + int2bytes(round, 8)
        + int2bytes(expiry, 8) + int2bytes(cents, 8) + int2bytes(time, 8)
    );
    require(checkSigFromStack(adminSig, adminPk, attestMsg), "oracle service");
    require(bytes2int(substr(next, 1, 8)) == round + 1, "round");
    require(substr(next, SLOTS, 8) == int2bytes(expiry, 8), "slot expiry");
    let slotValue = int2bytes(cents, 8) + int2bytes(time, 8) + int2bytes(0, 16);
    require(substr(next, VALUE_AT, 32) == slotValue, "slot value");
    require(substr(next, HISTORY_AT, HISTORY) == substr(prev, SLOTS, HISTORY), "history");
    require(tx.outputs[0].value >= tx.input.current.value, "value");
    continues(next);
  }

  @allow(unsigned-spend-path, "permissionless read preserves state and pays readFee")
  function read(int selfIndex) {
    require(selfIndex == this.activeInputIndex, "self index");
    bytes state = tx.packet(STATE);
    require(state == tx.inputs[selfIndex].packet(STATE), "state carried");
    require(tx.outputs[0].value >= tx.input.current.value + readFee, "read fee");
    continues(state);
  }

  @allow(unsigned-spend-path, "authorized by adminPk checkSigFromStack over round and next script")
  function migrate(ScriptPubKey next, signature opSig) {
    require(this.activeInputIndex == 0, "beacon is input 0");
    bytes state = tx.packet(STATE);
    require(state == tx.inputs[0].packet(STATE), "state carried");
    require(size(state) == SIZE, "state size");
    int round = bytes2int(substr(state, 1, 8));
    let msg = sha256(domain + "migrate" + ctrlTxid + int2bytes(ctrlGidx, 4) + int2bytes(round, 8) + next.program);
    require(checkSigFromStack(opSig, adminPk, msg), "oracle service");
    require(tx.outputs[0].script == next, "next script");
    require(tx.outputs[0].value >= tx.input.current.value, "value");
    require(tx.outputs[0].assets.lookup(AssetId { txid: ctrlTxid, gidx: ctrlGidx }) == 1, "identity asset");
  }

  function unilateral(signature adminSig) tapscript {
    require(older(exit));
    require(checkSig(adminSig, adminPk));
  }
}
