  "source": {
    "entry": "attestation_beacon.ark",
    "files": {
      "attestation_beacon.ark": "pragma arkade ^0.1.0;\n\n// AttestationBeacon: a price registry that other covenants read by spending\n// it in the same transaction.\n//\n// One to five oracle keys sign each sample. `signersN` is how many of the five\n// slots are real, and `threshold` is how many of those must sign (at least 1).\n// A sample is\n// sha256(ctrlTxid || 0x425443555344 || num2bin(expiry, 8) || num2bin(price, 8) || num2bin(time, 8)).\n// The expiry is the time the price belongs to. A signature for one expiry cannot write another.\n// Anyone who has those signatures can write that slot. The aggregator does that\n// in one transaction. Reading the coin still adds readFee, paid by the vault.\n// The sample time must sit in [expiry, expiry + expiryLag], so a print fixes only the\n// minute it was taken. The clock must have reached expiry + expiryLag, so a fixing\n// cannot land before its close.\n// adminPk migrates the coin and takes the unilateral exit. It does not sign prices.\n//\n// State is the extension packet of type STATE, 329 bytes:\n//   0        version, 0x01\n//   1..9     round, num2bin(round, 8)\n//   9..329   8 slots of 40 bytes, newest first: expiry num2bin(expiry, 8), value 32 bytes\n// The value keeps the price in the first 8 bytes. The next 8 are the sample\n// time. The rest are zero. An expiry already in a slot cannot be replaced. After\n// it falls off, the same signatures can write it again, and only those: a\n// different price or time does not verify.\n//\n// `read` adds readFee sats to output 0. The vault being settled pays that fee\n// out of its locked collateral. There is no third input.\n\ncontract AttestationBeacon(\n  bytes32 ctrlTxid,\n  int ctrlGidx,\n  pubkey[5] signers,\n  int signersN,\n  int threshold,\n  bytes domain,\n  int expiryLag,\n  int readFee,\n  pubkey adminPk,\n  int exit\n) {\n  const int STATE = 32;\n  const int SIZE = 329;\n  const int SLOTS = 9;\n  const int VALUE_AT = 17;\n  const int HISTORY_AT = 49;\n  const int HISTORY = 280;\n  const int PRICE_MAX = 1000000000;\n\n  private function committee() {\n    require(signersN >= 1, \"signers\");\n    require(signersN <= 5, \"signers\");\n    require(threshold >= 1, \"threshold\");\n    require(threshold <= signersN, \"threshold\");\n    if (signersN > 1) {\n      require(signers[0] != signers[1], \"duplicate signer\");\n    }\n    if (signersN > 2) {\n      require(signers[0] != signers[2], \"duplicate signer\");\n      require(signers[1] != signers[2], \"duplicate signer\");\n    }\n    if (signersN > 3) {\n      require(signers[0] != signers[3], \"duplicate signer\");\n      require(signers[1] != signers[3], \"duplicate signer\");\n      require(signers[2] != signers[3], \"duplicate signer\");\n    }\n    if (signersN > 4) {\n      require(signers[0] != signers[4], \"duplicate signer\");\n      require(signers[1] != signers[4], \"duplicate signer\");\n      require(signers[2] != signers[4], \"duplicate signer\");\n      require(signers[3] != signers[4], \"duplicate signer\");\n    }\n  }\n\n  private function continues(bytes state) {\n    require(size(state) == SIZE, \"state size\");\n    require(substr(state, 0, 1) == 0x01, \"state version\");\n    require(tx.outputs[0].script == tx.input.current.script, \"script\");\n    require(tx.outputs[0].assets.lookup(ctrlTxid, ctrlGidx) == 1, \"identity asset\");\n  }\n\n  private function absent(bytes prev, int expiry) {\n    int[8] slots = [9, 49, 89, 129, 169, 209, 249, 289];\n    for (i, offset) in slots {\n      require(substr(prev, offset, 8) != num2bin(expiry, 8), \"expiry already in a slot\");\n    }\n  }\n\n  function attest(int expiry, int price, int time, signature[5] sigs) {\n    require(this.activeInputIndex == 0, \"beacon is input 0\");\n    require(expiry > 1800, \"expiry\");\n    if (expiryLag >= 0) {\n      require(checkTime(expiry + expiryLag), \"before expiry time\");\n    }\n    require(price > 0, \"nonpositive price\");\n    require(price <= PRICE_MAX, \"price cap\");\n    require(time >= expiry, \"sample before expiry\");\n    require(time <= expiry + expiryLag, \"sample after close\");\n    committee();\n    let ticker = 0x425443555344;\n    let msg = sha256(ctrlTxid + ticker + num2bin(expiry, 8) + num2bin(price, 8) + num2bin(time, 8));\n    int valid = 0;\n    for (i, sig) in sigs {\n      if (i < signersN) {\n        if (checkSigFromStack(sig, signers[i], msg)) {\n          valid = valid + 1;\n        }\n      }\n    }\n    require(valid >= threshold, \"quorum\");\n\n    bytes prev = tx.inputs[0].packet(STATE);\n    bytes next = tx.packet(STATE);\n    require(size(prev) == SIZE, \"prev size\");\n    require(size(next) == SIZE, \"next size\");\n    require(substr(prev, 0, 1) == 0x01, \"prev version\");\n    require(substr(next, 0, 1) == 0x01, \"next version\");\n    absent(prev, expiry);\n    require(bin2num(substr(next, 1, 8)) == bin2num(substr(prev, 1, 8)) + 1, \"round\");\n    require(substr(next, SLOTS, 8) == num2bin(expiry, 8), \"slot expiry\");\n    let slotValue = num2bin(price, 8) + num2bin(time, 8) + num2bin(0, 16);\n    require(substr(next, VALUE_AT, 32) == slotValue, \"slot value\");\n    require(substr(next, HISTORY_AT, HISTORY) == substr(prev, SLOTS, HISTORY), \"history\");\n    require(tx.outputs[0].value >= tx.input.current.value, \"value\");\n    continues(next);\n  }\n\n  function read(int selfIndex) {\n    require(selfIndex == this.activeInputIndex, \"self index\");\n    bytes state = tx.packet(STATE);\n    require(state == tx.inputs[selfIndex].packet(STATE), \"state carried\");\n    require(tx.outputs[0].value >= tx.input.current.value + readFee, \"read fee\");\n    continues(state);\n  }\n\n  function migrate(ScriptPubKey next, signature opSig) {\n    require(this.activeInputIndex == 0, \"beacon is input 0\");\n    bytes state = tx.packet(STATE);\n    require(state == tx.inputs[0].packet(STATE), \"state carried\");\n    require(size(state) == SIZE, \"state size\");\n    int round = bin2num(substr(state, 1, 8));\n    let msg = sha256(domain + \"migrate\" + ctrlTxid + num2bin(ctrlGidx, 4) + num2bin(round, 8) + next.program);\n    require(checkSigFromStack(opSig, adminPk, msg), \"oracle service\");\n    require(tx.outputs[0].script == next, \"next script\");\n    require(tx.outputs[0].value >= tx.input.current.value, \"value\");\n    require(tx.outputs[0].assets.lookup(ctrlTxid, ctrlGidx) == 1, \"identity asset\");\n  }\n\n  function unilateral(signature adminSig) tapscript {\n    require(older(exit));\n    require(checkSig(adminSig, adminPk));\n  }\n}\n"
    }
  },
